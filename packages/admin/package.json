{
  "name": "@redeem/admin",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ajna/pagination": "^1.4.19",
    "@chakra-ui/react": "^2.8.2",
    "@chakra-ui/theme-tools": "^2.1.2",
    "@chakra-ui/utils": "^2.0.14",
    "@datadog/browser-rum": "^4.8.1",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.8.1",
    "@opengovsg/design-system-react": "^1.21.0",
    "@xstate/cli": "^0.5.17",
    "@xstate/react": "^3.2.2",
    "axios": "^0.28.1",
    "camelcase-keys": "^9.1.3",
    "capital-case": "^1.0.4",
    "chakra-ui-steps": "^2.1.0",
    "dompurify": "^3.1.6",
    "focus-visible": "^5.2.0",
    "framer-motion": "^11.1.9",
    "html2pdf.js": "^0.10.2",
    "launchdarkly-react-client-sdk": "^3.3.2",
    "lodash": "^4.17.20",
    "moment": "^2.29.1",
    "papaparse": "^5.3.2",
    "prop-types": "^15.7.2",
    "qrcode": "^1.4.4",
    "qs": "^6.12.1",
    "react": "^18.3.1",
    "react-app-polyfill": "^3.0.0",
    "react-charts": "3.0.0-beta.57",
    "react-csv": "^2.2.2",
    "react-dom": "^18.3.1",
    "react-dropzone": "^11.7.1",
    "react-error-boundary": "^4.0.11",
    "react-hook-form": "^7.52.0",
    "react-hot-toast": "^2.1.1",
    "react-icons": "^5.2.1",
    "react-query": "^3.33.4",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "react-table": "^7.8.0",
    "snakecase-keys": "^8.0.1",
    "use-debounce": "^10.0.1",
    "xstate": "^4.37.2"
  },
  "scripts": {
    "dev": "pnpm start",
    "start": "concurrently \"npm run xstate:watch\" \"PORT=3001 react-scripts start\"",
    "build": "npm run xstate:gen && env-cmd -f .env.${REACT_APP_ENV} react-scripts build",
    "build:develop": "REACT_APP_ENV=development npm run build",
    "build:staging": "REACT_APP_ENV=staging npm run build",
    "build:production": "REACT_APP_ENV=production npm run build",
    "build:vapt": "REACT_APP_ENV=vapt npm run build",
    "lint": "eslint ./ --ignore-path .gitignore && prettier . -c",
    "lint:fix": "eslint ./ --ignore-path .gitignore --fix && prettier . -c --write",
    "unused-exports": "ts-unused-exports tsconfig.json --showLineNumber --silent",
    "test": "react-scripts test",
    "test:e2e": "tsc --incremental -p tests/e2e/tsconfig.json && env-cmd -f .env.test playwright test --config playwright.config.ts",
    "test:e2e:update": "tsc --incremental -p tests/e2e/tsconfig.json && env-cmd -f .env.test playwright test --config playwright.config.ts --update-snapshots",
    "test:e2e:ci": "percy exec --parallel -- pnpm test:e2e",
    "percy:ci:build": "percy build:finalize",
    "eject": "react-scripts eject",
    "xstate:gen": "xstate typegen \"./src/**/*Machine.ts?(x)\"",
    "xstate:watch": "xstate typegen \"./src/**/*Machine.ts?(x)\" --watch"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@percy/cli": "^1.29.0",
    "@percy/playwright": "^1.0.6",
    "@playwright/test": "^1.45.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.8",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.3.3",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-world-flags": "^1.4.5",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.14.1",
    "concurrently": "^8.2.2",
    "env-cmd": "^10.1.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-chakra-ui": "^0.11.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^4.3.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "sass": "^1.77.6",
    "stylelint": "^16.7.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.1",
    "stylelint-scss": "^6.3.2",
    "ts-unused-exports": "^10.1.0",
    "type-fest": "^2.19.0",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged",
      "pre-push": "npm run unused-exports"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0",
    "*.{css, scss}": "stylelint --fix"
  },
  "eslintIgnore": [
    "public/index.html"
  ]
}
