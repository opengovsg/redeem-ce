# Environment specifc non-secret settings for tests
# This env is injected in npm run test:e2e

# Server config
REACT_APP_REDEEM_URL=http://localhost:10000
REACT_APP_SIGNUP_URL=http://localhost:5162

# Warning banner shows in all environments apart from testing and production. 
# We don't want this to show up on our testing environment because we want
# Percy to correctly reflect how production looks. 
REACT_APP_IS_HIDE_NON_PRODUCTION_FLAGS=true

REACT_APP_IS_CREATE_VOUCHER_ADDRESS_USE_PREFILL=true

REACT_APP_IS_CREATE_VOUCHER_ADDRESS_USE_PREFILL=true

